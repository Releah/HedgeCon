{
  "name": "hedgecon",
  "productName": "HedgeCon",
  "version": "0.2.6-experimental.1",
  "private": true,
  "description": "A self-contained connectivity console for network operations",
  "author": "HedgeCon contributors",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "typecheck": "tsc -b --pretty false && tsc -p electron/tsconfig.json --pretty false",
    "start": "electron .",
    "package:win": "pnpm build && electron-builder --win portable --x64 --publish never",
    "package:win:installer": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "release:win": "pnpm build && electron-builder --win nsis portable --x64 --publish always",
    "package:linux": "pnpm build && electron-builder --linux AppImage --x64 --publish never",
    "release:linux": "pnpm build && electron-builder --linux AppImage --x64 --publish always"
  },
  "build": {
    "appId": "io.hedgecon.app",
    "productName": "HedgeCon",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/hedgecon.ico",
      "artifactName": "HedgeCon.${ext}"
    },
    "nsis": {
      "artifactName": "HedgeCon-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HedgeCon",
      "uninstallDisplayName": "HedgeCon",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "HedgeCon.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/hedgecon-logo.png",
      "category": "Network",
      "artifactName": "HedgeCon-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Releah",
      "repo": "HedgeCon",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.8.9",
    "isomorphic-git": "^1.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.16.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
